                    UML Diagrams
=====================================================

Circle:
-----------------------------------------------------
+MIN_RADIUS:int{readOnly}=1
-radius:int{readOnly}
-color:String
-cx:int
-cy:int
-----------------------------------------------------
+Circle(radius:double, color:String, cx:int, cy:int)
+getCx():int
+getCy():int
+getColor():String
+getRadius():int
+setCx(x:int):void
+setCy(y:int):void
setCenter(cx:int,cy:int):void
+setColor(color:String):void
+getArea():double
+hit(x:int,y:int):boolean
+display():String
+biggerThan(other:Circle):boolean
-----------------------------------------------------

CIRCLE OBJECT
=====================================================

public class Circle{
  public static final int MIN_RADIUS = 1;
  private final int radius;
  private String color;
  private int cx;
  private int cy;

  public Circle (double radius, String color, int cx, int cy){
    this.radius = radius;
    this.color = color;
    this.cx = cx;
    this.cy = cy;
  }

  public int getCx(){
    return cx;
  }

  public int getCy(){
    return cy;
  }

  public String getColor(){
    return color;
  }

  public int getRadius(){
    return radius;
  }

  public void setCx(int cx){
    this.cx = cx;
  }
  
  public void setCy(int cy){
    this.cy = cy;
  }

  public void setCenter(int cx, int cy){
    this.cx = cx;
    this.cy = cy;
  }

  public void setColor(String color){
    this.color = color;
  }

  public double getArea(){
    return Math.PI * Math.pow(radius, 2);
  }

  public boolean hit(int x, int y){
    return false;
  }

  public String display(){
    return
  }

  public boolean biggerThan(Circle other){
    return false;
  }

CIRCLE DRIVER
=====================================================

public class CircleDriver {
  static void main(){
    Circle c1 = new Circle(5, "red", 3, 2);
    System.out.println(c1.display());
    Circle c2 = new Circle(-2, "blue", 1, 1);
    System.out.println(c2.display());
  
